datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN") // "SUPER_ADMIN", "ADMIN", "STAFF"
  isActive     Boolean  @default(true)
  permissions  String?  // JSON string array of permission codes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String         @id @default(uuid())
  name         String
  mobile       String
  email        String         @unique
  passwordHash String
  role         String         // "BUYER", "SELLER", "DEALER", "COMMON_PEOPLE"
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  properties   Property[]
  activities   UserActivity[]

  @@index([email])
  @@index([role, isActive])
}

model Category {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([isActive, displayOrder])
}

model Property {
  id            String          @id @default(uuid())
  title         String
  category      String
  description   String?
  location      String
  city          String?
  price         Float
  priceDisplay  String?
  status        String          @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "HOLD"
  planType      String          @default("PLATINUM") // "PLATINUM", "GOLD", "STANDARD"
  sellerId      String?
  sellerName    String?
  sellerPhone   String?
  sellerEmail   String?
  sellerRole    String?         @default("SELLER") // "SELLER", "DEALER", "COMMON_PEOPLE"
  dealerCompany String?
  categorySpecs String?         // JSON serialized specs
  pointsAwarded Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  images        PropertyImage[]
  seller        User?           @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  bookings      PropertyBooking[]

  @@index([status, city])
  @@index([category, status])
  @@index([price])
  @@index([sellerId])
  @@index([createdAt])
}

model PropertyBooking {
  id               String    @id @default(uuid())
  propertyId       String
  propertyTitle    String
  propertyCategory String?
  propertyPrice    Float?
  planType         String    @default("PLATINUM") // "GOLD" or "PREMIUM" / "PLATINUM"
  bookerRole       String    @default("DEALER") // "BUYER", "DEALER"
  bookerId         String?
  bookerName       String?
  bookerEmail      String?
  bookerPhone      String?
  dealerId         String?
  dealerName       String?
  dealerCompany    String?
  dealerEmail      String?
  dealerPhone      String?
  sellerId         String?
  sellerName       String?
  sellerEmail      String?
  sellerPhone      String?
  bookingAmount    Float?    @default(0)
  bookingStatus    String    @default("CONFIRMED") // "PENDING", "CONFIRMED", "COMPLETED", "CANCELLED"
  notes            String?
  bookingDate      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([sellerId])
  @@index([bookerId])
  @@index([bookingStatus])
}

model PropertyImage {
  id           String   @id @default(uuid())
  propertyId   String
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Plan {
  id          String   @id @default(uuid())
  planId      String   @unique // "gold", "platinum"
  name        String
  price       Float
  description String?
  benefits    String?  // JSON array
  features    String?  // JSON array
  isActive    Boolean  @default(true)
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reward {
  id            String   @id @default(uuid())
  userName      String
  userEmail     String?
  userRole      String?  @default("COMMON_PEOPLE") // "DEALER", "COMMON_PEOPLE", "SELLER"
  propertyTitle String?
  rewardTitle   String
  points        Int      @default(0)
  amount        Float    @default(0)
  reason        String?
  status        String   @default("PENDING") // "PENDING", "APPROVED", "PAID", "REJECTED"
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
}

model Report {
  id            String   @id @default(uuid())
  propertyId    String?
  propertyTitle String?
  category      String?
  userName      String?
  userEmail     String?
  userPhone     String?
  reason        String
  description   String
  status        String   @default("PENDING") // "PENDING", "RESOLVED", "REJECTED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerifiedPartner {
  id           String   @id @default(uuid())
  name         String
  type         String   // "Agency", "Broker", "Developer", "Consultant"
  company      String?
  mobile       String
  email        String
  status       String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  registeredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  group     String   // "home", "about", "service", "logo", "contact"
  updatedAt DateTime @updatedAt
}

model Chat {
  id             String   @id @default(uuid())
  userName       String
  userEmail      String?
  userAvatar     String?
  previewMessage String
  isRead         Boolean  @default(false)
  lastMessageAt  DateTime @default(now())
  messages       String?  // JSON array of message objects
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  eventType   String   @default("REMINDER") // "INSPECTION", "MEETING", "REMINDER", "DEADLINE"
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model UserActivity {
  id          String   @id @default(uuid())
  userId      String?
  userRole    String?  @default("BUYER") // "BUYER", "SELLER", "DEALER", "ANONYMOUS"
  actionType  String   // "VIEW_PROPERTY", "SEARCH", "FILTER", "SAVE_WISHLIST", "CONTACT_SELLER", "SUBMIT_PROPERTY"
  entityId    String?  // e.g. propertyId
  details     String?  // JSON serialized context or search query
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actionType])
  @@index([actionType, createdAt])
}

model PartnerWallet {
  id                  String             @id @default(uuid())
  partnerEmail        String             @unique
  partnerName         String?
  partnerPhone        String?
  partnerRole         String             @default("PARTNER")
  availablePoints     Int                @default(0)
  reservedPoints      Int                @default(0)
  totalEarnedPoints   Int                @default(0)
  totalRedeemedPoints Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  transactions        PointsLedger[]
  claims              RewardClaim[]
  bankDetail          PartnerBankDetail?

  @@index([partnerEmail])
}

model PointsLedger {
  id              String         @id @default(uuid())
  partnerEmail    String
  partnerName     String?
  partnerRole     String?
  propertyId      String?
  propertyTitle   String?
  claimId         String?
  transactionType String         // "PROPERTY_APPROVED", "REWARD_RESERVED", "REWARD_PAID", "REWARD_CLAIM_REJECTED", "REWARD_POINTS_RELEASED", "ADMIN_ADJUSTMENT"
  points          Int            // e.g. +20, -500, +500
  balanceBefore   Int
  balanceAfter    Int
  description     String
  adminId         String?
  adminName       String?
  createdAt       DateTime       @default(now())
  wallet          PartnerWallet? @relation(fields: [partnerEmail], references: [partnerEmail], onDelete: Cascade)

  @@index([partnerEmail])
  @@index([propertyId])
  @@index([transactionType])
  @@index([createdAt])
}

model PartnerBankDetail {
  id                String        @id @default(uuid())
  partnerEmail      String        @unique
  partnerName       String
  accountHolderName String
  accountNumber     String
  ifscCode          String
  bankName          String
  upiId             String?
  mobileNumber      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  wallet            PartnerWallet @relation(fields: [partnerEmail], references: [partnerEmail], onDelete: Cascade)

  @@index([partnerEmail])
}

model RewardClaim {
  id                   String         @id @default(uuid())
  claimNumber          String         @unique // e.g. "CLM-1001"
  partnerEmail         String
  partnerName          String
  partnerPhone         String?
  partnerRole          String?        @default("PARTNER")
  redeemedPoints       Int
  rewardAmount         Float
  conversionRate       String?        // e.g. "500 Points = ₹500"
  bankAccountHolder    String
  bankAccountNumber    String
  ifscCode             String
  bankName             String
  upiId                String?
  mobileNumber         String?
  status               String         @default("PENDING") // "PENDING", "APPROVED", "PROCESSING", "PAID", "REJECTED"
  adminNotes           String?
  rejectionReason      String?
  paymentReference     String?        // Transaction reference / UTR ID
  paymentDate          DateTime?
  processedByAdminId   String?
  processedByAdminName String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  wallet               PartnerWallet? @relation(fields: [partnerEmail], references: [partnerEmail], onDelete: Cascade)

  @@index([partnerEmail])
  @@index([status])
  @@index([createdAt])
}

model RewardSetting {
  id                String   @id @default(uuid())
  pointsPerReward   Int      @default(500)
  rewardAmountInInr Float    @default(500)
  pointsPerProperty Int      @default(20)
  updatedBy         String?
  updatedAt         DateTime @updatedAt
}
